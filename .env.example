# Secret API key for authorizing workout creation, updates, and deletion
# Required in production or when calling APIs externally (via curl, iOS Shortcuts, etc.)
# Bypassed automatically when running locally (NODE_ENV=development)
WORKOUT_API_KEY=your_secret_api_key_here

# Optional: Customize the athlete name displayed in header and app title
# Defaults to "Robin" if omitted
NEXT_PUBLIC_ATHLETE_NAME=Robin

# Optional: Comma-separated admin emails who have full edit/submit permissions
# Any other authenticated Cloudflare Access user will have read-only access (Edit & Submit disabled)
ADMIN_EMAILS=robin@example.com
